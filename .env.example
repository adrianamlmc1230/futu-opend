# =====================================================================
# Collector 端
# =====================================================================
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_KEY=your-service-role-jwt

OPEND_HOST=127.0.0.1
OPEND_PORT=11111

FLUSH_INTERVAL=2.0
MAX_QUEUE_SIZE=50000
HEALTH_CHECK_INTERVAL=30

# =====================================================================
# Archiver 端
# =====================================================================
# Postgres 直連字串（Supabase Dashboard → Project Settings → Database → Connection string）
# 注意：URL 中的密碼若含 @ / : / # 等特殊符號要 URL-encode
#
# pooler URL (port 6543, transaction mode)：給一般 SELECT/DELETE 用
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# direct URL (port 5432)：給 VACUUM FULL 用（pgbouncer transaction-mode 不支援 VACUUM）
# 沒設的話會跳過 VACUUM FULL，autovacuum 只會清 dead tuple 但不還空間
SUPABASE_DB_DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Cloudflare R2（S3 相容）
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=<r2-access-key>
S3_SECRET_ACCESS_KEY=<r2-secret>
S3_BUCKET_NAME=futu-cold-storage
S3_REGION=auto

# 排程
ARCHIVE_TIME=04:30
ARCHIVER_RUN_AT_STARTUP=0
